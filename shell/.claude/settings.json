{
  "env": {
    "ANTHROPIC_BASE_URL": "https://ai-gateway.contentful.tools/",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Write(*)",
      "Bash(npm run *)",
      "Bash(./node_modules/.bin/*)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(sed-n *p *)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(curl:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(go:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(poetry:*)",
      "Bash(docker:*)",
      "Bash(make:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",
      "Bash(source:*)",
      "Bash(sqlite3:*)"
    ],
    "deny": [
      "Bash(pnpm exec nx deploy *)",
      "Bash(pnpm exec nx package *)",
      "Bash(pnpm exec nx release *)",
      "Bash(pnpm dlx *)",
      "Bash(sed *-i*)",
      "Bash(sed *w *)",
      "Bash(sed *>*)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "visual-explainer@visual-explainer-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "skills": [
    "grill-me",
    "grill-with-docs",
    "write-a-skill",
    "to-issues",
    "to-prd"
  ]
}
